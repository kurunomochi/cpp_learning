[Unit]
Description=Modern C++ tutorial task server
After=network.target

[Service]
Type=simple
User=taskapi
Group=taskapi
WorkingDirectory=/var/lib/task-server
StateDirectory=task-server
Environment=APP_HOST=127.0.0.1
Environment=APP_PORT=8080
Environment=APP_DB=/var/lib/task-server/tasks.db
EnvironmentFile=/etc/task-server.env
ExecStart=/usr/local/bin/task_server
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
